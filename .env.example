# SQLite محلي — يتم إنشاؤه تلقائياً
DATABASE_URL=file:./data/edms.db

# مسار محرك Tesseract OCR (v5.x) — اختياري، يُكتشف تلقائياً من مواقع التثبيت الشائعة
# القيمة المتوقعة على هذا الجهاز:
TESSERACT_PATH=E:\Program Files\Tesseract-OCR\tesseract.exe

# مطلوب لتوقيع جلسة الكوكي (HMAC-SHA256) — القيمة أدناه للتطوير فقط،
# استبدلها بمفتاح عشوائي قوي عند النشر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# بدون AUTH_SECRET يعمل النظام بمفتاح احتياطي للتطوير مع تحذير في السجل.
AUTH_SECRET=dev-only-change-me-before-deploy
# عند النشر خلف HTTPS، ارفع secure: true لخيارات الكوكي في src/lib/session.ts
# (افتراضياً secure: false ليعمل على HTTP و HTTPS معاً — راجع تعليق الكود).

# Next.js
# localhost للـ dev فقط — عند النشر ضع عنوان النطاق الفعلي
NEXT_PUBLIC_APP_URL=http://localhost:3000

# أصول الـ dev الإضافية المسموحة (مفصولة بفواصل) — اختياري، يُقرأ في next.config.ts
# مثال: ALLOWED_DEV_ORIGINS=http://192.168.1.10:3000,http://10.0.0.5:3000
# ALLOWED_DEV_ORIGINS=
